{
  "name": "sereneflow",
  "version": "1.0.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear",
    "deploy:dev": "npm run build:web && npx firebase deploy --only hosting -P dev",
    "deploy:prod": "npm run build:web && npx firebase deploy --only hosting -P prod"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.2.3",
    "@expo-google-fonts/jost": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
